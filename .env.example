PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
# JWT_SECRET: Minimum 32 characters required in production
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
CLIENT_URL=http://localhost:5173,http://localhost:5174
NODE_ENV=development

# ==========================================
# 🤖 Nebius AI Studio / NVIDIA Nemotron Config
# ==========================================
# Obtain your API key from https://studio.nebius.ai/
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
# Model identifier for NVIDIA Nemotron on Nebius AI Studio
NEMOTRON_MODEL_ID=nvidia/llama-3.1-nemotron-70b-instruct
AI_REQUEST_TIMEOUT_MS=15000

# ==========================================
# 🛡️ API Security & Rate Limiting Configuration
# ==========================================
# Maximum requests per window (leave unset for secure production defaults)
# RATE_LIMIT_AUTH_MAX=15        # Max auth attempts per 15-min window
# RATE_LIMIT_DEVICE_MAX=15      # Max device login attempts per 15-min window
# RATE_LIMIT_SOS_MAX=10         # Max emergency SOS triggers per 1-min window
# RATE_LIMIT_AI_MAX=20          # Max AI requests per 1-min window
# TRUST_PROXY=true              # Enable if running behind reverse proxy (ALB, Nginx)
# RATE_LIMIT_DISABLED=false     # Set to true only in automated CI/CD integration tests if needed
